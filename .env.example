# ─────────────────────────────────────────────────────────────────────────────
# banking-backend — environment variables
#
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=banking
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production
KEYCLOAK_HOSTNAME=localhost
# In production, set this to your actual domain:
# KEYCLOAK_HOSTNAME=auth.yourdomain.com

# ── Postal SMTP ───────────────────────────────────────────────────────────────
POSTAL_SECRET_KEY=generate_with_openssl_rand_hex_64
POSTAL_HOSTNAME=localhost
MAIL_FROM=noreply@banking.local

# ── Spring Boot App ───────────────────────────────────────────────────────────
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_in_production
GRAFANA_DOMAIN=localhost

# ── Fee policy ────────────────────────────────────────────────────────────────
# NONE | NIGERIAN_INTERBANK | PERCENTAGE | FLAT
FEE_POLICY_TYPE=NONE

# ── Overdraft policy ──────────────────────────────────────────────────────────
# NONE | FIXED_LIMIT
OVERDRAFT_POLICY_TYPE=NONE

# ── CORS (comma-separated) ────────────────────────────────────────────────────
# CORS_ORIGIN_1=https://your-frontend.com
# CORS_ORIGIN_2=https://admin.your-domain.com
